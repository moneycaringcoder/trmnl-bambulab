# Sanitized local TRMNL preview data.
#
# Copy this file to .trmnlp.yml in the repository root, beside src/. The
# destination is git-ignored because
# a developer may later add an API key; never put credentials in this example.
---
watch:
  - src
  - .trmnlp.yml
transform_runtime: disabled
time_zone: UTC
variables:
  # This is bridge/fixtures/merged/printing.synthetic.json expressed as YAML so
  # the container can render it while mounting only the plugin directory.
  v: 1
  updated_at: "2026-01-01T00:00Z"
  printers:
    - state: printing
      raw_state: SYNTHETIC_RUNNING
      name: Demo Printer One
      model: Demo Model A
      online: true
      stale: false
      progress: 42
      layer: 81
      layers: 194
      remaining: 1h 16m
      stage: Synthetic printing check
      nozzle: 220
      nozzle_target: 220
      bed: 60
      bed_target: 60
      material: Demo PLA
      job:
      alert:
    - state: idle
      raw_state: SYNTHETIC_IDLE
      name: Demo Printer Two
      model: Demo Model B
      online: true
      stale: false
      progress:
      layer:
      layers:
      remaining:
      stage:
      nozzle: 24
      nozzle_target:
      bed: 23
      bed_target:
      material:
      job:
      alert:
  hidden: 0
  cloud: connected
