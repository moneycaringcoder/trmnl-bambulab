{
  "name": "trmnl-bambulab-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reads Bambu Cloud and pushes a Bambu Lab printer status snapshot to a TRMNL webhook.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "setup": "node src/setup/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "scan": "../scripts/secret-scan.sh --tree"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
