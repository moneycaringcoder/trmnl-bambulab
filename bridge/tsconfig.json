{
  "compilerOptions": {
    // ES2024 for `Promise.withResolvers`, which Node 22 has and which lets the
    // shutdown and sleep paths read as straight-line code.
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // `pnpm setup` runs the CLI straight from source under Node's type
    // stripping, so relative imports carry a `.ts` extension. tsc rewrites
    // them to `.js` when the bridge is compiled into `dist/`.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["spikes", "dist", "node_modules"]
}
