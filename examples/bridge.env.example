# trmnl-bambulab bridge configuration example.
#
# Copy to bridge/.env (git-ignored) or let `pnpm setup` write it for you.
# Never commit a filled copy. Never paste real values into a chat, an issue,
# a screenshot, or a commit message.

# ---------------------------------------------------------------------------
# Bambu Cloud
# ---------------------------------------------------------------------------
# global for bambulab.com, china for bambulab.cn
BAMBU_CLOUD_REGION=global

# Obtained by `pnpm setup`. Your account password is never stored.
BAMBU_CLOUD_ACCESS_TOKEN=

# A masked hint only, so `pnpm setup reauth` can say whose account it is.
# Never the raw email.
BAMBU_CLOUD_ACCOUNT_HINT=

# Which printers to show, comma separated. Chosen during `pnpm setup`.
BAMBU_CLOUD_DEVICE_IDS=

# ---------------------------------------------------------------------------
# TRMNL
# ---------------------------------------------------------------------------
# Treat this as a credential: it contains the plugin-setting UUID, and anyone
# holding it can write to your display. May be left empty until the Private
# Plugin exists; fill it in later with `pnpm setup webhook`.
TRMNL_WEBHOOK_URL=

# Standard accounts: 12 pushes/hour and 2 kB. TRMNL+: 30/hour and 5 kB.
TRMNL_MAX_PUSHES_PER_HOUR=12
TRMNL_MAX_PAYLOAD_BYTES=2048

# Show the real job name on the display. Defaults to false because a job name
# can reveal a private model name.
TRMNL_EXPORT_JOB_NAME=false

LOG_LEVEL=info
