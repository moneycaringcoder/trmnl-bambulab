{
  "name": "trmnl-bambulab-hosted",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs the hosted Bambu Cloud to TRMNL polling tier on Cloudflare Workers and Neon.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:dom": "vitest run test/setup-dom.test.js",
    "hosted:key": "node --input-type=module -e \"import('@trmnl-bambulab/core/hosted/crypto').then(async ({ generateKeyBase64 }) => console.log(await generateKeyBase64()))\""
  },
  "dependencies": {
    "@trmnl-bambulab/core": "workspace:*",
    "liquidjs": "^10.30.0"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@types/node": "^22.20.5",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
