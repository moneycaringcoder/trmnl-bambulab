{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // One module Worker; the compatibility date pins today's runtime behaviour,
  // and nodejs_compat supports the Neon client without changing bridge code.
  "name": "trmnl-bambulab-hosted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],

  "rules": [
    { "type": "Text", "globs": ["**/*.liquid"], "fallthrough": true }
  ],

  // Five minutes because Bambu is the thing being protected, not TRMNL. The
  // twelve-pushes-an-hour ceiling no longer applies — the hosted tier is polled
  // rather than pushing — but the cron is now the only thing that reads Bambu,
  // and one read per account per five minutes is a rate we are comfortable
  // defending. `FRESH_FOR_MS` in src/screen.ts is three missed cycles of this.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Both stated rather than left to default, because the default for each is
  // "on" and Wrangler warns about exactly that on every deploy.
  //
  // `workers_dev` is the URL the setup page and TRMNL actually use, so it stays.
  //
  // `preview_urls` is off. It would publish a second hostname for every version
  // ever uploaded, each one serving this Worker's whole surface: the enrolment
  // API and `GET /v1/screen`. A screen key would work against all of them, and a
  // stale version would keep answering with whatever code it shipped with. The
  // rate ceilings still apply, and sign-in would fail there because those hosts
  // are not registered as trusted origins — but none of that is a reason to
  // publish the surface in the first place.
  "workers_dev": true,
  "preview_urls": false,

  // The setup page. Static, because it is one HTML file and giving it a build
  // step would be the only build step in this package.
  //
  // `run_worker_first` is the load-bearing part: without it the asset server
  // answers first and shadows the API. `/trmnl/*` matters most — TRMNL's
  // install redirect and markup POSTs must reach the Worker, and the SPA
  // fallback would otherwise answer the install handshake with the page and a
  // 200. Every route the Worker owns is listed; anything else is the page.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    // `/__scheduled` is Wrangler's local cron trigger. It is listed because the
    // asset server otherwise answers it with the page, which makes the cron
    // untestable in dev. No such route exists in production, where the Worker
    // runs first and answers 404 like any other unknown path.
    "run_worker_first": ["/v1/*", "/trmnl/*", "/healthz", "/__scheduled"]
  },

  // Workers Logs indexes the one-object-per-line events from log.ts.
  //
  // `invocation_logs` goes under `logs`, not directly under `observability`.
  // Wrangler's schema marks `observability` as additionalProperties:false and
  // silently drops a misplaced key, so putting it one level too high configures
  // nothing while looking like it configures something.
  //
  // It is off because Cloudflare's automatic Fetch event records
  // `<Method> <URL>` for every request, and `/v1/screen` is called on every
  // device refresh. The screen key travels in an Authorization header rather
  // than the query string, so a URL log would not capture it today — but an
  // automatic per-request log on an internet-facing authenticated route is a
  // standing invitation to leak whatever ends up in a URL later, and it is
  // volume an anonymous caller controls on a route with no rate limit. This
  // tier gets its observability from the scheduled handler instead.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },

  // Two counters, because the two things worth stopping have nothing in common.
  //
  // SCREEN_ADDRESS_LIMITER is consulted *before* anything on the `/trmnl/`
  // surface can reach Postgres, so it is a real ceiling on what an anonymous
  // caller can make us spend. A counter consulted after the lookup would bound
  // nothing: the query is already paid for by then. At 300 per minute per
  // Cloudflare location, TRMNL's own markup requests never approach it.
  //
  // ENROL_LIMITER below bounds what one installation can make Bambu do.
  //
  // Both are per location, so the real ceiling is a multiple of these numbers.
  // They are cost guards rather than accounting, which is what the platform
  // documents them as.
  "ratelimits": [
    {
      "name": "SCREEN_ADDRESS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      // Bounds one signed-in person, keyed by their owner tag. The route that
      // makes Bambu send an email is why this exists: identity bounds who can
      // trigger it, and this bounds how often, so an account here cannot be
      // turned into a way to mail somebody repeatedly. Ten a minute is generous
      // for a person filling in a form and useless for anything else.
      "name": "ENROL_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Wrangler validates these names without putting either secret value in Git.
  // Add a new TOKEN_KEY_<ID> here while retaining old keys during key rotation.
  // TOKEN_KEY_K1 in particular must be the *same* key that sealed the existing
  // rows: a fresh one silently orphans every enrolment. A deploy that forgets
  // one fails instead of shipping a Worker whose cron cannot open a token.
  //
  // NEON_AUTH_BASE_URL is gone deliberately: identity is TRMNL's now. The
  // install handshake mints a per-installation access token, and there is no
  // identity provider, no JWKS, and no sign-in of our own to configure.
  "secrets": {
    "required": ["DATABASE_URL", "TOKEN_KEY_K1"]
  },

  // Neither of these is secret. The key id chooses which configured key seals
  // new tokens, while older required keys stay available to open existing rows
  // during a rotation.
  //
  // The key id is not secret: it chooses which configured key seals new tokens,
  // while older required keys stay available to open existing rows during a
  // rotation.
  "vars": {
    "TOKEN_KEY_CURRENT_ID": "k1"
  }
}
