{% comment %}
Minimal printer status for a quadrant. It spends the limited space on a state
word or percentage, remaining time, and a high-contrast alert marker.
{% endcomment %}

<div class="list">
  {% for printer in printers %}
    <div class="item">
      <div class="content">
        {% assign unreadable = false %}
        {% if printer.stale or printer.state == "offline" or printer.state == "unknown" %}
          {% assign unreadable = true %}
        {% endif %}
        {% if printer.alert and unreadable == false %}<span class="value value--xsmall">! ALERT</span>{% endif %}

        {% if printer.stale %}
          <span class="value value--base">Reading old</span>
          <span class="label">{% if printer.name %}{{ printer.name | escape }}{% else %}Printer{% endif %}</span>
        {% elsif printer.state == "offline" %}
          <span class="value value--base">Offline</span>
          <span class="label">{% if printer.name %}{{ printer.name | escape }}{% else %}Printer{% endif %}</span>
        {% elsif printer.state == "unknown" %}
          <span class="value value--base">Unknown</span>
          <span class="label">{% if printer.name %}{{ printer.name | escape }}{% else %}Printer{% endif %}</span>
        {% elsif printer.state == "idle" %}
          <span class="value value--base">Ready</span>
          <span class="label">{% if printer.name %}{{ printer.name | escape }}{% else %}Printer{% endif %}</span>
        {% else %}
          {% if printer.progress %}
            {% if printers.size == 3 %}
              <span class="value value--base value--tnums">{{ printer.progress | escape }}%</span>
            {% else %}
              <span class="value value--large value--tnums">{{ printer.progress | escape }}%</span>
            {% endif %}
          {% else %}
            <span class="value value--base">{{ printer.state | capitalize | escape }}</span>
          {% endif %}
          <span class="label">{% if printer.name %}{{ printer.name | escape }}{% else %}Printer{% endif %}</span>
          {% if printer.remaining %}<span class="description">{{ printer.remaining | escape }} left</span>{% endif %}
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% render "plugin_note", hidden: hidden, cloud: cloud %}
